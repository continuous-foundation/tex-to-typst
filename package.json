{
  "name": "tex-to-typst",
  "version": "0.0.20",
  "description": "Translate tex math code to typst",
  "keywords": [
    "Typst",
    "LaTeX"
  ],
  "author": "Rowan Cockett <rowan@continuousfoundation.org>",
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/continuous-foundation/tex-to-typst",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/continuous-foundation/tex-to-typst.git"
  },
  "bugs": {
    "url": "https://github.com/continuous-foundation/tex-to-typst/issues"
  },
  "scripts": {
    "prepublishOnly": "bun run build && bun run test",
    "clean": "rm -rf dist",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:format": "prettier --check \"src/**/*.{ts,tsx,md}\"",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "build:esm": "tsc --project ./tsconfig.json --outDir dist --declaration",
    "build": "bun run clean && bun run build:esm",
    "changeset": "changeset",
    "version": "changeset version && bun install",
    "publish": "bun run clean && bun run build && changeset publish && git push --follow-tags"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.0",
    "@types/js-yaml": "^4.0.9",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "js-yaml": "^4.2.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1"
  },
  "dependencies": {
    "@unified-latex/unified-latex": "^1.4.0",
    "@unified-latex/unified-latex-util-arguments": "^1.4.0",
    "@unified-latex/unified-latex-util-parse": "^1.4.0",
    "unified": "^10.1.2"
  }
}
